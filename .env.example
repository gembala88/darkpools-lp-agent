# ── Wallet ────────────────────────────────────────────────────────────────────
WALLET_PRIVATE_KEY=your_base58_private_key_here

# ── Solana RPC ─────────────────────────────────────────────────────────────────
RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_helius_api_key_here

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Option A: OpenRouter (default)
OPENROUTER_API_KEY=sk-or-your_openrouter_key_here

# Option B: LM Studio (local) — uncomment these and comment out OPENROUTER_API_KEY
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_API_KEY=lm-studio
# LLM_MODEL=your-model-name-from-lmstudio

# ── API Keys ───────────────────────────────────────────────────────────────────
# NVIDIA API keys: comma-separated for automatic round-robin rotation
# (reduces 429 rate limits when using NVIDIA's free-tier endpoints)
NVIDIA_API_KEYS=key1,key2,key3
# Fallback if NVIDIA_API_KEYS is not set
NVIDIA_API_KEY=your_nvidia_api_key_here
HELIUS_API_KEY=your_helius_api_key_here
LPAGENT_API_KEY=your_lpagent_api_key_here
BIRDEYE_API_KEY=your_birdeye_api_key_here
JUPITER_API_KEY=your_jupiter_api_key_here
GMGN_API_KEY=your_gmgn_api_key_here
PUBLIC_API_KEY=your_public_api_key_here
HIVEMIND_API_KEY=your_hivemind_api_key_here

# ── Jupiter Referral ──────────────────────────────────────────────────────────
JUPITER_REFERRAL_ACCOUNT=your_referral_account_address
JUPITER_REFERRAL_FEE_BPS=50

# ── Agent Meridian ────────────────────────────────────────────────────────────
AGENT_MERIDIAN_API_URL=https://api.agentmeridian.com

# ── Encryption ────────────────────────────────────────────────────────────────
ENVRYPT_KEY=
ENVCRYPT_KEY=

# ── Telegram Notifications (optional) ─────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=

# ── Dangerous admin actions (disabled by default) ─────────────────────────────
ALLOW_SELF_UPDATE=false

# ── Hive Mind (optional) ──────────────────────────────────────────────────────
HIVE_MIND_URL=
HIVE_MIND_API_KEY=

# ── Real capital deployment (TWO gates required) ──────────────────────────────
# Gate 1: DRY_RUN=true keeps everything in paper mode (default for safety)
# Gate 2: ENABLE_REAL_DEPLOYMENT=true explicitly opts in to live trading
# BOTH must be set to deploy real capital:
#   DRY_RUN=false + ENABLE_REAL_DEPLOYMENT=true = live trading
DRY_RUN=true
ENABLE_REAL_DEPLOYMENT=false
LOG_LEVEL=info
